# Durable validation event store (Upstash Redis via the Vercel Marketplace).
# `vercel integration add upstash` injects these automatically.
# The direct-Upstash names UPSTASH_REDIS_REST_URL / _TOKEN are also accepted.
#
# Production and Preview MUST point at different databases. Analytics keys are
# additionally namespaced by environment, so a mistake here cannot mix the two
# datasets — but a shared database still means one careless database-wide flush
# destroys both. Use `npm run flush -- <namespace>` instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Which store the credentials above belong to: production | preview | development.
# Optional. When it disagrees with VERCEL_ENV, the internal dashboard shows a
# configuration warning instead of silently trusting the setup.
ANALYTICS_STORE_ENV=

# Bearer token guarding /validation and /api/validation.
# Generate with: openssl rand -hex 32
VALIDATION_TOKEN=
